{
    "name": "minhyung/laravel-openobserve",
    "description": "Laravel package for OpenObserve integration - centralized log management and monitoring",
    "type": "library",
    "keywords": ["laravel", "openobserve", "logging", "monitoring", "observability"],
    "license": "MIT",
    "authors": [
        {
            "name": "Minhyung Park",
            "email": "urlinee@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/overworks/laravel-openobserve/issues",
        "source": "https://github.com/overworks/laravel-openobserve"
    },
    "require": {
        "php": "^8.4.1",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/console": "^13.0",
        "illuminate/support": "^13.0",
        "minhyung/openobserve": "^0.1",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "php-http/mock-client": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Minhyung\\LaravelOpenObserve\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Minhyung\\LaravelOpenObserve\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test"
        ],
        "format": "pint",
        "lint": "pint --test",
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Minhyung\\LaravelOpenObserve\\OpenObserveServiceProvider"
            ],
            "aliases": {
                "OpenObserve": "Minhyung\\LaravelOpenObserve\\Facades\\OpenObserve"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "prefer-stable": true
}
